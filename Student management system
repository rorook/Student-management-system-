<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Student Grade Management System</title>
<style>
:root{--bg:#f6f8fb;--card:#fff;--ink:#1c2430;--mute:#5f6b7a;--line:#d5dce6;--accent:#1f3a5f;--accent-ink:#fff}
@media (prefers-color-scheme:dark){:root{--bg:#10151c;--card:#18202a;--ink:#e6ebf2;--mute:#9aa7b8;--line:#2c3744;--accent:#6ea8ff;--accent-ink:#0b1220}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:720px;margin:0 auto;padding:20px 16px 40px}
h1{font-size:1.5rem;margin:0 0 2px}
.sub{color:var(--mute);margin:0 0 16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px;margin-bottom:14px}
.row{display:flex;gap:8px;flex-wrap:wrap}
input{flex:1 1 140px;padding:10px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);font:inherit}
button{padding:10px 14px;border:0;border-radius:8px;background:var(--accent);color:var(--accent-ink);font:inherit;font-weight:600;cursor:pointer}
button.alt{background:transparent;color:var(--accent);border:1px solid var(--accent)}
#msg{min-height:1.5em;color:var(--mute);margin:8px 0 0}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px}
.stat{padding:8px 10px;border:1px solid var(--line);border-radius:8px}
.stat b{display:block;font-size:1.05rem}
.stat span{color:var(--mute);font-size:.85rem}
.wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse}
th,td{text-align:left;padding:8px 6px;border-bottom:1px solid var(--line)}
th{color:var(--mute);font-weight:600;font-size:.85rem}
td button{padding:4px 10px;font-size:.85rem}
</style>
</head>
<body>
<main>
  <h1>Student Grade Management System</h1>
  <p class="sub">Web version of the C++ program. Every record is stored in one array.</p>

  <section class="card">
    <form id="add" class="row">
      <input id="name" placeholder="Student name" autocomplete="off" required>
      <input id="mark" type="number" min="0" max="100" step="any" placeholder="Mark (0-100)" required>
      <button>Add</button>
    </form>
    <div class="row" style="margin-top:8px">
      <button class="alt" id="sample" type="button">Load sample data</button>
      <button class="alt" id="sort" type="button">Sort by mark</button>
    </div>
    <p id="msg" role="status"></p>
  </section>

  <section class="card"><div class="stats" id="stats"></div></section>

  <section class="card">
    <input id="q" placeholder="Search by name" style="width:100%;margin-bottom:8px">
    <div class="wrap">
      <table>
        <thead><tr><th>No.</th><th>Name</th><th>Mark</th><th>Grade</th><th></th></tr></thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
  </section>
</main>

<script>
const MAX = 100;
const students = [];   // the array that holds every student record
const $ = id => document.getElementById(id);
const say = text => { $("msg").textContent = text; };
const grade = m => m >= 80 ? "A" : m >= 70 ? "B" : m >= 60 ? "C" : m >= 50 ? "D" : "F";

// Insert: place the new record at the next free index
function addStudent(name, mark) {
  if (students.length >= MAX) return say("The array is full (100 students).");
  students[students.length] = { name, mark };
  say("Added " + name + ".");
}

// Delete: shift every later element one place to the left
function deleteStudent(index) {
  const removed = students[index].name;
  for (let k = index; k < students.length - 1; k++) students[k] = students[k + 1];
  students.length--;
  say("Removed " + removed + ".");
}

// Selection sort: repeatedly move the highest remaining mark to the front
function sortByMark() {
  if (students.length < 2) return say("Nothing to sort.");
  for (let i = 0; i < students.length - 1; i++) {
    let best = i;
    for (let j = i + 1; j < students.length; j++)
      if (students[j].mark > students[best].mark) best = j;
    [students[i], students[best]] = [students[best], students[i]];
  }
  say("Sorted from highest to lowest mark.");
}

// Linear search: compare the search text with each name in turn
function search(text) {
  const hits = [], key = text.trim().toLowerCase();
  for (let i = 0; i < students.length; i++)
    if (students[i].name.toLowerCase().includes(key)) hits.push(i);
  return hits;
}

function render() {
  // Traverse: show every matching element
  const body = $("rows");
  body.textContent = "";
  const hits = search($("q").value);
  hits.forEach(i => {
    const s = students[i], tr = body.insertRow();
    [i + 1, s.name, s.mark.toFixed(1), grade(s.mark)].forEach(v => { tr.insertCell().textContent = v; });
    const del = document.createElement("button");
    del.textContent = "Delete";
    del.onclick = () => { deleteStudent(i); render(); };
    tr.insertCell().appendChild(del);
  });
  if (!hits.length) {
    const cell = body.insertRow().insertCell();
    cell.colSpan = 5;
    cell.textContent = students.length ? "No student matches." : "No students yet. Add one or load the sample data.";
  }

  // Statistics: one pass over the array for total, highest and lowest
  let total = 0, hi = 0, lo = 0;
  for (let i = 0; i < students.length; i++) {
    total += students[i].mark;
    if (students[i].mark > students[hi].mark) hi = i;
    if (students[i].mark < students[lo].mark) lo = i;
  }
  const n = students.length;
  const show = k => students[k].mark.toFixed(1) + " (" + students[k].name + ")";
  const items = [["Students", n], ["Average", n ? (total / n).toFixed(2) : "-"],
                 ["Highest", n ? show(hi) : "-"], ["Lowest", n ? show(lo) : "-"]];
  $("stats").textContent = "";
  items.forEach(([label, value]) => {
    const box = document.createElement("div"), val = document.createElement("b"), lab = document.createElement("span");
    box.className = "stat";
    val.textContent = value;
    lab.textContent = label;
    box.append(val, lab);
    $("stats").append(box);
  });
}

$("add").onsubmit = e => {
  e.preventDefault();
  const name = $("name").value.trim(), mark = parseFloat($("mark").value);
  if (!name || !(mark >= 0 && mark <= 100)) return say("Enter a name and a mark between 0 and 100.");
  addStudent(name, mark);
  $("name").value = "";
  $("mark").value = "";
  $("name").focus();
  render();
};
$("sort").onclick = () => { sortByMark(); render(); };
$("q").oninput = render;
$("sample").onclick = () => {
  [["Alice Johnson", 78.5], ["Brian Lee", 91], ["Chloe Adams", 64], ["David Okoye", 55.5], ["Emma Wilson", 82]]
    .forEach(([n, m]) => { if (students.length < MAX) addStudent(n, m); });
  say("Sample data loaded.");
  render();
};
render();
</script>
</body>
</html>
